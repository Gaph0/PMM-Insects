<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Give the wild insect pawn kinds the same wild-man behaviour as vanilla WildMan.
		The vanilla Humanlike think tree only applies MainWildManBehaviorCore + the idle
		wander to pawnKind=WildMan, so a wild insect momo would otherwise fall through
		to the guest branch and immediately JobGiver_ExitMapBest off the map on her
		first think tick (the Reptiles lesson: incident + gates + spawn can all work
		and the pawn still walks straight off). These subtrees are inserted via the
		Humanlike_PostMain insertTag, mirroring the vanilla wild-man branches.

		Every wild insect kind must be listed or it will walk straight off the map:
		PMM_WildDevilBug / GiantAnt / SoldierBeetle / Greenworm / VampMosquito /
		Abaddon. The Odyssey kinds carry MayRequire on their defs; a missing
		pawnKind here is harmless (the conditional just never fires).
	-->
	<ThinkTreeDef>
		<defName>PMM_InsectWildBehavior</defName>
		<insertTag>Humanlike_PostMain</insertTag>
		<thinkRoot Class="ThinkNode_Priority">
			<subNodes>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildDevilBug</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildGiantAnt</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildSoldierBeetle</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildGreenworm</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildVampMosquito</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildAbaddon</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>MainWildManBehaviorCore</treeDef>
							<leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
						</li>
					</subNodes>
				</li>

			</subNodes>
		</thinkRoot>
	</ThinkTreeDef>

	<!-- The idle wander branch (what the wild woman does between threats): the same
	     JobGiver_WanderAnywhere the vanilla WildMan idle subtree uses. -->
	<ThinkTreeDef>
		<defName>PMM_InsectWildIdle</defName>
		<insertTag>Humanlike_PostMain</insertTag>
		<thinkRoot Class="ThinkNode_Priority">
			<subNodes>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildDevilBug</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildGiantAnt</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildSoldierBeetle</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildGreenworm</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildVampMosquito</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

				<li Class="ThinkNode_ConditionalPawnKind">
					<pawnKind>PMM_WildAbaddon</pawnKind>
					<subNodes>
						<li Class="ThinkNode_Tagger">
							<tagToGive>Idle</tagToGive>
							<subNodes>
								<li Class="JobGiver_WanderAnywhere">
									<maxDanger>Deadly</maxDanger>
									<ticksBetweenWandersRange>120~240</ticksBetweenWandersRange>
								</li>
							</subNodes>
						</li>
					</subNodes>
				</li>

			</subNodes>
		</thinkRoot>
	</ThinkTreeDef>

</Defs>
