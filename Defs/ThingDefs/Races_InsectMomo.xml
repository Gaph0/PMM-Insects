		<description>An insect momo born of the megascarab. Her feelers never stop twitching, scenting the sweat and mana of men, and she scuttles after what she smells with tireless, simple-minded hunger.</description>
		<statBases>
			<MoveSpeed>3.75</MoveSpeed>
			<ArmorRating_Sharp>0.72</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.18</ArmorRating_Blunt>
			<ComfyTemperatureMin>0</ComfyTemperatureMin>
			<ComfyTemperatureMax>60</ComfyTemperatureMax>
			<MarketValue>100</MarketValue>
			<ToxicResistance>1</ToxicResistance>
			<ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
			<FilthRate>1</FilthRate>
		</statBases>
		<tools>
			<li>
				<label>left fist</label>
				<labelNoLocation>fist</labelNoLocation>
				<capacities><li>Blunt</li></capacities>
				<power>8.2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
			</li>
			<li>
				<label>right fist</label>
				<labelNoLocation>fist</labelNoLocation>
				<capacities><li>Blunt</li></capacities>
				<power>8.2</power>
				<cooldownTime>2</cooldownTime>
