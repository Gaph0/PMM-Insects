<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Insect-momo races: humanlike clones of Human (BodyDef Human, Humanlike render
		tree, human life stages and think trees) with the corresponding insect's stats
		overlaid 1:1 — chitin armor, health scale, body size, speed, cold-blooded
		comfort range, toxin/vacuum immunity and the bug's melee tools. Butchered
		they yield insect flesh exactly like the bugs they replace (fleshType
		Insectoid, useMeatFrom Megaspider = insect meat, no leather) and bleed
		insect ichor. The Insect faction's own hostility makes hive/raid ones
		enemies regardless of race. VacuumResistance is Odyssey-gated exactly as
		on BaseInsect.
	-->

	<!-- ===================== Devil Bug (was: Megascarab, Core) ===================== -->
	<ThingDef ParentName="BasePawn" Name="PMM_InsectMomoBase" Abstract="True">
		<race>
			<thinkTreeMain>Humanlike</thinkTreeMain>
			<thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
			<intelligence>Humanlike</intelligence>
			<makesFootprints>true</makesFootprints>
			<fleshType>Insectoid</fleshType>
			<bloodDef>Filth_BloodInsect</bloodDef>
			<useMeatFrom>Megaspider</useMeatFrom>
			<meatColor>(160,168,139)</meatColor>
			<meatMarketValue>0.5</meatMarketValue>
			<nameCategory>HumanStandard</nameCategory>
			<body>Human</body>
			<renderTree>Humanlike</renderTree>
			<foodType>OmnivoreHuman</foodType>
			<gestationPeriodDays>18</gestationPeriodDays>
			<manhunterOnDamageChance>0.50</manhunterOnDamageChance>
			<soundCallIntervalRange>2000~5000</soundCallIntervalRange>
			<!-- Humanlike lifespan. The bugs' own lifeExpectancy (4-75y) is far below the
			     HumanlikeAdult minAge (18), so PawnGenerator's age curve could not roll a
			     valid adult age -> "Tried 300 times to generate age". Momos are
			     functionally ageless anyway (core's Momo gene stops fertility decline and
		     old-age ailments), so a human 80 is the right base. lifeExpectancy is the
		     ONE stat not copied 1:1 from the bugs — never re-add it to a child def,
		     not even the queen's 75. -->
			<lifeExpectancy>80</lifeExpectancy>
			<lifeStageAges>
				<li>
					<def>HumanlikeBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>HumanlikeChild</def>
					<minAge>3</minAge>
				</li>
				<li MayRequire="Ludeon.RimWorld.Biotech">
					<def>HumanlikePreTeenager</def>
					<minAge>9</minAge>
				</li>
				<li>
					<def>HumanlikeTeenager</def>
					<minAge>13</minAge>
				</li>
				<li>
					<def>HumanlikeAdult</def>
					<minAge>18</minAge>
				</li>
			</lifeStageAges>
			<soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
			<specialShadowData>
				<volume>(0.3, 0.8, 0.4)</volume>
				<offset>(0,0,-0.3)</offset>
			</specialShadowData>
			<hediffGiverSets>
				<li>OrganicStandard</li>
				<li>Human</li>
			</hediffGiverSets>
		</race>
		<recipes Inherit="True" />
		<comps>
			<!-- A daughter of the swarm is fed by the hive: standing near a nest (a Hive)
			     tops up her hunger and mana. See HiveNourishment.cs. -->
			<li Class="PMM_Insects.CompProperties_HiveNourishment">
				<radius>12</radius>
				<intervalTicks>600</intervalTicks>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="PMM_InsectMomoBase">
