<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		The egg-sac end of the brood chain (Phase 5, 2026-09-20). See
		Defs/AbilityDefs/Abilities_EggSpew.xml for the ability that throws these.

		Both defs started as clones of the vanilla egg-sac projectile and sac. What they
		are now:
		  - the projectile spawns OUR sac, and it is `PMM_Insects.Projectile_EggSac`, which
		    copies the queen's brood order onto that sac at impact;
		  - the sac's spawn comp is `PMM_Insects.CompEggSacBrood`, which derives from vanilla's
		    CompSpawnPawnOnDestroyed and honours that order. Vanilla hardcodes age 0 and
		    `allowDowned: false`, and a newborn humanlike is always downed - that is the
		    2026-09-20 "Generated downed pawn" cascade, and why the hatch cannot be a def tweak;
		  - a sac whose brood is NOT humanlike - a swarmling, or one saved before the picker
		    existed - goes straight through vanilla's own hatch, `CompSpawnLarva` included: age
		    0, the stun-flyer hop and `lordJob LordJob_WanderNest` are all wanted for a larva.
		    None of them are right for a three year old mamono, who stands up where the sac was.

		Why the brood lands in the right faction (verified in Assembly-CSharp 1.6):
		Projectile_SpawnsThing.Impact ends with
		    if (thing.def.CanHaveFaction) thing.SetFaction(base.Launcher.Faction);
		so the sac takes the caster's faction, and CompSpawnPawnOnDestroyed spawns the
		pawn with `Faction faction = parent.Faction` - the sac's. `category` must stay
		Building for that to apply: ThingDef.CanHaveFaction is true for Pawns and
		Buildings only, and it ignores `isInert` entirely.

		When it hatches: only DestroyMode.KillFinalize counts, so the sac must be KILLED - a
		dev-tool destroy or a deconstruct spawns nothing, exactly as with vanilla's sac. A
		swarmling is generated at age 0, the larva stage of her kind, and she hops up to 5 cells
		away on a PawnFlyer_Stun - exactly what vanilla's larva does. From there VFEI2's own
		CompProperties_SwarmlingToCocoon takes over: she cocoons, and a random adult insectoid
		of the hive crawls out. A mamono sac is the other case: the caste the queen chose is
		generated at age 3, a child, and she simply stands up where the sac was.
	-->
	<ThingDef ParentName="BaseGrenadeProjectile">
		<defName>PMM_Proj_EggSac</defName>
		<label>egg sac</label>
		<!-- Ours rather than vanilla's Projectile_SpawnsThing: it does everything vanilla does
		     and then writes the queen's brood order onto the sac it just spawned. -->
		<thingClass>PMM_Insects.Projectile_EggSac</thingClass>
		<graphicData>
			<texPath>Things/Projectile/PMM_EggSac</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<speed>21</speed>
			<damageAmountBase>0</damageAmountBase>
			<spawnsThingDef>PMM_EggSac</spawnsThingDef>
			<tryAdjacentFreeSpaces>true</tryAdjacentFreeSpaces>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BuildingNaturalBase">
		<defName>PMM_EggSac</defName>
		<label>egg sac</label>
		<description>A slimy sac holding a growing insect. The gestation process generates a faint bioluminescent glow. Kill it and the brood inside crawls out - which daughter she is, the queen decides.</description>
		<thingClass>Building</thingClass>
		<category>Building</category>
		<graphicData>
			<texPath>Things/Building/PMM_EggSac</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.3</fillPercent>
		<rotatable>false</rotatable>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<statBases>
			<MaxHitPoints>20</MaxHitPoints>
			<Flammability>0.4</Flammability>
			<Beauty>-6</Beauty>
		</statBases>
		<building>
			<isInert>true</isInert>
			<claimable>false</claimable>
			<deconstructible>false</deconstructible>
			<repairable>false</repairable>
			<quickTargetable>true</quickTargetable>
			<isTargetable>true</isTargetable>
			<expandHomeArea>false</expandHomeArea>
		</building>
		<comps>
			<li Class="CompProperties_Glower">
				<glowRadius>6</glowRadius>
				<glowColor>(113,141,117,0)</glowColor>
			</li>
			<!-- The brood, hatched when the sac is killed. `pawnKind` is the fallback for a sac
			     nobody told anything; a humanlike order never uses it, those go through our comp's
			     own hatch. VFEI2_Swarmling is VFEI2's own juvenile kind - the same pawn their
			     queen and empress spawn - and it metamorphoses into an adult insect. -->
			<li Class="PMM_Insects.CompProperties_EggSacBrood">
				<pawnKind>VFEI2_Swarmling</pawnKind>
				<lordJob>LordJob_WanderNest</lordJob>
				<!-- How old a hatched mamono is. 0 = a newborn, and that is the ruling rather
				     than a test value: the abaddon raises her brood from 0 (user's ruling
				     2026-10-01), and it is the C# default as well now, so a sac that lost this
				     line would still hatch a newborn. -->
				<biologicalAge>0</biologicalAge>
			</li>
			<li Class="CompProperties_SpawnEffecterOnDestroy">
				<effect>CocoonDestroyed</effect>
			</li>
		</comps>
	</ThingDef>

</Defs>
