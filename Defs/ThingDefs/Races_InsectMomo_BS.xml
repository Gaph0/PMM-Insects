<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Insect-momo races on the Big & Small pattern (Route A, Phase 5).

		Each species is two defs:
		1. A ThingDef on ParentName="Human" carrying BigAndSmall.RaceExtension ->
		   its race-tracker hediff. Stats that must live race-level (baseBodySize,
		   baseHealthScale, baseHungerRate, insect flesh/blood/meat, melee tools)
		   stay on the ThingDef, overlaid 1:1 from the bug it replaces - same as
		   the old BasePawn clones.
		2. A race-tracker HediffDef (ParentName="BS_DefaultRaceTracker") holding
		   the pawn-level statBases as a stat stage, plus the RaceExtension for
		   B&S race handling (romance tags, size scaling).

		The three winged castes carry a second tracker, Big & Small's own
		BS_HumanoidWithWings_Race, through raceHediffList - that one draws the wings.
		Merging the two into one def was tried on 2026-09-20 and RimWorld refused to
		load it: a node is registered for XML inheritance only when it carries a
		<Name> attribute (XmlInheritance.TryRegister never reads "defName"), and B&S
		declares its trackers with <defName> alone. The log then fills with "Could not
		find parent node named BS_HumanoidWithWings_Race" and the tracker loads with
		no art and no comps. One row would mean our tracker declaring its own copy of
		the wing render nodes (referencing B&S's GraphicSetDefs by name); that waits on
		a decision. Never declare <comps> on a tracker whose parent is B&S's own
		tracker either: child list nodes merge into the parent's, so the pawn ends up
		with two race comps.

		What Route A buys over the old BasePawn clones:
		- B&S's scaler reads baseBodySize and renders bug girls at their real size
		  (0.2 devil bug scuttling at your feet, 2.0 Abaddon overhead) with working
		  camera/melee handling - vanilla humanlikes always drew at 1x.
		- Race features become composable PawnExtensions/tracker stages instead of
		  a monolithic race clone, so genes and xenotypes layer cleanly on top.
		- The chitin render tag (PMM_ChitinGraphics) is wired into core's color
		  channels, ready for exoskeleton art later.

		This file is the ONLY source of race defs - the old BasePawn clone file
		(Races_InsectMomo.xml) was deleted 2026-09-20; its six defNames live here.

		lifeExpectancy: never add it to a species here. Human base gives 80 for
		free, and that is the number we want. The bugs' own lifeExpectancy (4-75y)
		sits far below HumanlikeAdult's minAge of 18, so PawnGenerator's age curve
		could not roll a valid adult age -> "Tried 300 times to generate age".
		Momo are functionally ageless anyway (core's Momo gene stops fertility
		decline and old-age ailments). This is the ONE stat not copied 1:1 from
		the bugs - not even the queen's 75. Re-adding it breaks age generation.
	-->

	<!-- ===================== Devil Bug (was: Megascarab, Core) ===================== -->
	<ThingDef ParentName="Human">
		<defName>PMM_Race_DevilBug</defName>
		<label>devil bug</label>
		<description>An insect momo born of the megascarab. Her feelers never stop twitching, scenting the sweat and mana of men, and she scuttles after what she smells with tireless, simple-minded hunger.</description>
		<statBases>
			<MoveSpeed>3.75</MoveSpeed>
			<!-- Armor moved OUT of statBases: it lives on the race tracker as a
			     hediff stat stage now, so ALL pawn-level toughness sits in one
			     hidden hediff (user ruling 2026-09-19). It no longer doubles with
			     gear or reads as a race quirk on the info card. -->
			<!-- Visual/mechanical size for B&S. The scaler does NOT read baseBodySize
			     for the render size of humanlikes - it reads the SM_BodySizeMultiplier
			     STAT (this is how B&S's own Centaur declares 1.15x). Without this the
			     devil bug rendered at 1.0 no matter what baseBodySize said.
			     Set to match baseBodySize 0.6: a short woman, not doll-sized. -->
			<SM_BodySizeMultiplier>0.6</SM_BodySizeMultiplier>
			<ComfyTemperatureMin>0</ComfyTemperatureMin>
			<ComfyTemperatureMax>60</ComfyTemperatureMax>
			<MarketValue>100</MarketValue>
			<!-- 30 chitin a corpse, the value VFEI2's own insect races carry. Human
			     would give 75 of whatever leather it wears. -->
			<LeatherAmount>30</LeatherAmount>
			<ToxicResistance>1</ToxicResistance>
			<ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
			<FilthRate>1</FilthRate>
		</statBases>
		<tools>
			<li>
				<label>left fist</label>
				<labelNoLocation>fist</labelNoLocation>
				<capacities><li>Blunt</li></capacities>
				<power>8.2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
			</li>
			<li>
				<label>right fist</label>
				<labelNoLocation>fist</labelNoLocation>
				<capacities><li>Blunt</li></capacities>
				<power>8.2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
			</li>
			<li>
				<label>mandibles</label>
				<capacities><li>Bite</li></capacities>
				<power>5</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
			</li>
			<li>
				<label>head</label>
				<capacities><li>Blunt</li></capacities>
				<power>4</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.1</chanceFactor>
			</li>
		</tools>
		<race>
			<!-- Race-level insect identity, copied 1:1 from the old BasePawn clone:
			     insect flesh and ichor, bug meat when butchered, and the bug's size
			     package. B&S reads baseBodySize for render scaling; large races get
			     renderCacheOff automatically in the scaler.
			     baseBodySize raised 0.2 -> 0.6 (user ruling 2026-09-19): 0.2 was the
			     megascarab's literal size and rendered her doll-small. 0.6 is a short
			     woman. Health scale and hunger stay at the bug's values. -->
			<fleshType>Insectoid</fleshType>
			<bloodDef>Filth_BloodInsect</bloodDef>
			<useMeatFrom>Megaspider</useMeatFrom>
			<meatColor>(160,168,139)</meatColor>
			<meatMarketValue>0.5</meatMarketValue>
			<!-- Chitin, not the Leather_Human this race would inherit from its Human
			     parent: VFEI2's own insects are skinned for VFEI2_Chitin, the same
			     30 per corpse they use, so a dead insector feeds the economy the
			     tribes trade in. -->
			<leatherDef>VFEI2_Chitin</leatherDef>
			<baseBodySize>0.6</baseBodySize>
			<baseHealthScale>0.4</baseHealthScale>
			<baseHungerRate>0.10</baseHungerRate>
			<manhunterOnDamageChance>0.50</manhunterOnDamageChance>
			<!-- Chitin over a tiny frame: PMM_Insects.HealthScalePatch (Harmony)
			     multiplies HealthScale for PMM_Race_* defs x2.5. Vanilla HealthScale
			     drives every body part's max HP, limbs AND organs:
			     0.4 base x 2.5 = 1.0 effective, so her 8-HP arm becomes ~20 HP.
			     Punches bruise instead of amputating. Race-level, no gene stacking.
			     (The factor lives in HealthScalePatch.cs - RaceProperties has no
			     such field, and inventing one throws XML errors at load.) -->
		</race>
		<!-- A daughter of the swarm is fed by the hive: standing near a nest (a Hive)
		     tops up her hunger and mana. See HiveNourishment.cs. -->
		<comps>
			<li Class="PMM_Insects.CompProperties_HiveNourishment">
				<radius>12</radius>
				<intervalTicks>600</intervalTicks>
			</li>
		</comps>
		<modExtensions>
			<li Class="BigAndSmall.RaceExtension">
				<raceHediff>PMM_RaceTracker_DevilBug</raceHediff>
			</li>
		</modExtensions>
	</ThingDef>

	<!-- Devil Bug race tracker. Auto-applies on spawn via RaceExtension.
	     Armor lives here as a stat stage, not on race statBases: one hediff
	     carries every pawn-level toughness knob (a statBases copy too would
	     STACK - she showed 1.44 sharp in-game that way). Stays visible in
	     the Health tab like every B&S race tracker - RaceTracker hardcodes
	     Visible = true, and we follow the framework.
	     No renderNodeProperties yet - exoskeleton art comes later through
	     PMM_ChitinGraphics. -->
	<HediffDef ParentName="BS_DefaultRaceTracker">
		<defName>PMM_RaceTracker_DevilBug</defName>
		<label>devil bug</label>
		<description>A devil bug momo of the swarm.</description>
		<stages Inherit="False">
			<li>
				<!-- The bug's armor, moved here from race statBases. -->
				<statOffsets>
					<ArmorRating_Sharp>0.72</ArmorRating_Sharp>
					<ArmorRating_Blunt>0.18</ArmorRating_Blunt>
				</statOffsets>
			</li>
		</stages>
		<comps>
			<li Class="BigAndSmall.CompProperties_Race">
				<canSwapAwayFrom>true</canSwapAwayFrom>
			</li>
		</comps>
		<modExtensions>
			<li Class="BigAndSmall.PawnExtension">
				<!-- Hard shell, squishy inside: internal damage is divided by 3
				     (damage / idd in B&S's pipeline, so 3 = internal organs take a
				     third). Blades glance off chitin or punch through without quickly
				     pulping anything vital. She still bleeds, still goes down - she
				     just stops dying outright. B&S's naga uses 0.4 for a FRAILE race;
				     we want the opposite. -->
				<internalDamageDivisor>3</internalDamageDivisor>
				<!-- Romance as a bug girl, not an animal. -->
				<romanceTags>
					<Insect>1.0</Insect>
					<Humanlike>0.65</Humanlike>
				</romanceTags>
			</li>
		</modExtensions>
	</HediffDef>


