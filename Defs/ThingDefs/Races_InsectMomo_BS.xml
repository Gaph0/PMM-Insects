			</li>
		</modExtensions>
	</HediffDef>

	<!-- ===================== Vamp Mosquito (was: Locust, Odyssey) ===================== -->
	<ThingDef ParentName="Human">
		<defName MayRequire="Ludeon.RimWorld.Odyssey">PMM_Race_VampMosquito</defName>
		<label>vamp mosquito</label>
		<description>An insect momo born of the locust. She circles her prey on buzzing wings, patient and cunning, until the moment is right - then her bite leaves a hot, itching mark that only she can soothe.</description>
		<statBases>
			<MoveSpeed>3.0</MoveSpeed>
			<SM_BodySizeMultiplier>0.6</SM_BodySizeMultiplier>
			<ComfyTemperatureMin>-10</ComfyTemperatureMin>
			<ComfyTemperatureMax>60</ComfyTemperatureMax>
			<MarketValue>120</MarketValue>
			<LeatherAmount>30</LeatherAmount>
			<ToxicResistance>1</ToxicResistance>
			<ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
			<FilthRate>1</FilthRate>
		</statBases>
		<tools>
			<li>
				<label>left fist</label>
				<labelNoLocation>fist</labelNoLocation>
				<capacities><li>Blunt</li></capacities>
				<power>8.2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
			</li>
			<li>
				<label>right fist</label>
				<labelNoLocation>fist</labelNoLocation>
				<capacities><li>Blunt</li></capacities>
				<power>8.2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
			</li>
			<li>
				<label>mandibles</label>
				<capacities><li>Bite</li></capacities>
				<power>6</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
			</li>
			<li>
				<label>head</label>
				<capacities><li>Blunt</li></capacities>
				<power>4</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.1</chanceFactor>
			</li>
		</tools>
		<race>
			<fleshType>Insectoid</fleshType>
			<bloodDef>Filth_BloodInsect</bloodDef>
			<useMeatFrom>Megaspider</useMeatFrom>
			<meatColor>(160,168,139)</meatColor>
			<meatMarketValue>0.5</meatMarketValue>
			<!-- Chitin, not the Leather_Human this race would inherit from its Human
			     parent: VFEI2's own insects are skinned for VFEI2_Chitin, the same
			     30 per corpse they use, so a dead insector feeds the economy the
			     tribes trade in. -->
			<leatherDef>VFEI2_Chitin</leatherDef>
			<baseBodySize>0.6</baseBodySize>
			<baseHealthScale>0.7</baseHealthScale>
			<baseHungerRate>0.15</baseHungerRate>
			<manhunterOnDamageChance>0.50</manhunterOnDamageChance>
			<!-- Wings live on the race, not on the flight gene. B&S's gene path
			     (Genes/GenePatches.cs) swaps with force:false and targetPriority:0,
			     and a race def that isn't literally Human keeps priority 200 - so
			     her own def always wins the fusion fallback and the gene's body
			     swap is silently refused. This body is what gives her real BS_Wing
			     parts; the winged tracker below draws them. -->
			<body>BS_HumanoidWithWings_Body</body>
		</race>
		<comps>
			<li Class="PMM_Insects.CompProperties_HiveNourishment">
				<radius>12</radius>
				<intervalTicks>600</intervalTicks>
			</li>
		</comps>
		<modExtensions>
			<li Class="BigAndSmall.RaceExtension">
				<raceHediff>PMM_RaceTracker_VampMosquito</raceHediff>
				<!-- B&S's winged tracker: draws her full wings for anything without
				     the flight gene. A weak-flight carrier has no Flagger, so this
				     tracker blanks itself and the gene's smaller wings show instead.
				     The strong flight gene raises the flags, so an abaddon keeps
				     these full-size wings. -->
				<raceHediffList>
					<li>BS_HumanoidWithWings_Race</li>
				</raceHediffList>
			</li>
		</modExtensions>
	</ThingDef>

	<HediffDef ParentName="BS_DefaultRaceTracker">
		<defName>PMM_RaceTracker_VampMosquito</defName>
		<label>vamp mosquito</label>
		<description>A vamp mosquito momo of the swarm.</description>
		<!-- No armor stage: the locust has none. Fragile flyer, exactly as the bug. -->
		<comps>
			<li Class="BigAndSmall.CompProperties_Race">
				<canSwapAwayFrom>true</canSwapAwayFrom>
			</li>
		</comps>
		<modExtensions>
			<li Class="BigAndSmall.PawnExtension">
				<romanceTags>
					<Insect>1.0</Insect>
					<Humanlike>0.65</Humanlike>
				</romanceTags>
			</li>
		</modExtensions>
	</HediffDef>

	<!-- ===================== Abaddon (was: HiveQueen, Odyssey) ===================== -->
	<ThingDef ParentName="Human">
		<defName MayRequire="Ludeon.RimWorld.Odyssey">PMM_Race_Abaddon</defName>
		<label>abaddon</label>
		<description>An insect momo born of the hive queen. Daughter of the bug mamono lord who once nearly devoured the world, she never sleeps, never hungers for rest, and endlessly brings forth daughters - her pheromones command the swarm and stir every man who smells them.</description>
		<statBases>
			<MoveSpeed>3.4</MoveSpeed>
			<!-- Queen size ruling (2026-09-20): 2.0x, down from the bug's literal
			     4.5 - the full queen scale crowded out every fight. Still towers
			     over colonists. B&S auto-applies renderCacheOff past 1.49. -->
			<SM_BodySizeMultiplier>2.0</SM_BodySizeMultiplier>
			<ComfyTemperatureMin>-40</ComfyTemperatureMin>
			<ComfyTemperatureMax>60</ComfyTemperatureMax>
			<MarketValue>2000</MarketValue>
			<LeatherAmount>30</LeatherAmount>
			<ToxicResistance>1</ToxicResistance>
			<ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
			<FilthRate>28</FilthRate>
		</statBases>
		<tools>
			<li>
				<label>left fist</label>
				<labelNoLocation>fist</labelNoLocation>
				<capacities><li>Blunt</li></capacities>
				<power>8.2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
			</li>
			<li>
				<label>right fist</label>
				<labelNoLocation>fist</labelNoLocation>
				<capacities><li>Blunt</li></capacities>
				<power>8.2</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
			</li>
			<li>
				<label>queen's claw</label>
				<capacities><li>Cut</li></capacities>
				<power>30</power>
				<cooldownTime>2.6</cooldownTime>
				<linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
			</li>
			<li>
				<label>head</label>
				<capacities><li>Blunt</li></capacities>
				<power>14</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
			</li>
		</tools>
		<race>
			<fleshType>Insectoid</fleshType>
			<bloodDef>Filth_BloodInsect</bloodDef>
			<useMeatFrom>Megaspider</useMeatFrom>
			<meatColor>(160,168,139)</meatColor>
			<meatMarketValue>0.5</meatMarketValue>
			<!-- baseBodySize matches SM_BodySizeMultiplier (2.0, was 4.5).
			     baseHealthScale stays 9.8: she is still the queen. -->
			<!-- Chitin, not the Leather_Human this race would inherit from its Human
			     parent: VFEI2's own insects are skinned for VFEI2_Chitin. The queen
			     yields the same 30 as her daughters, plus the 150 InsectJelly below. -->
			<leatherDef>VFEI2_Chitin</leatherDef>
			<baseBodySize>2.0</baseBodySize>
			<baseHealthScale>9.8</baseHealthScale>
			<needsRest>false</needsRest>
			<manhunterOnDamageChance>0.50</manhunterOnDamageChance>
			<!-- Race-level wings, same reason as the vamp mosquito: the flight
			     gene cannot swap the body of a pawn with her own race def. -->
			<body>BS_HumanoidWithWings_Body</body>
		</race>
		<comps>
			<li Class="CompProperties_SpreadSludge">
				<mtbTicks>15000</mtbTicks>
				<abilityDef>PMM_Ability_EggSpew</abilityDef>
			</li>
			<li Class="CompProperties_LetterOnRevealed">
