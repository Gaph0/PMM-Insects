<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Insector tribe pawnkinds: the castes that fill the tribe villages and their
		raids, plus the trader kind the caravan slot asks for.

		Wildness 0: these are faction NPCs, not wild animals - a 0.99-wildness
		humanlike hive queen would just go feral. defaultFactionDef points at the
		neutral tribe; the hostile tribe supplies itself through pawnGroupMakers,
		which is how faction generation works anyway. canArriveManhunter false
		(humanlikes cannot manhunt anyway). moveSpeedFactorByTerrainTag gives the
		2x bonus on insect sludge from InsectKindBase. All women, naked and unarmed,
		xenotype pinned per kind, and each carries its own per-species backstory
		category.

		"Pinned per kind" is a strong pin rather than an exact one: each kind declares
		its own caste at chance 100 in its `xenotypeSet`, the faction's roster set (the
		same list the villages roll from, totalling 1.0) is added to it because
		`PawnKindDef.useFactionXenotypes` defaults true, and a weighted roll decides.
		A slot comes out as its own caste about 99 times in 100, with the faction's
		list making up the rest; `useFactionXenotypes false` on a kind is what makes
		its slot exact.

		Where the six appear is decided in Defs/FactionDefs/Factions_InsectorTribes.xml,
		not here.

		No `<factionlessGenerationWeight>` on any kind here, and that is a correction
		rather than an omission: the field does not exist on `PawnKindDef` in 1.6, and five
		kinds carried it until 2026-09-27, when the game logged an XML error for each one
		and ignored them - dead config that read as live. The field is on `XenotypeDef`
		(`factionlessGenerationWeight 0`, set on every insect xenotype), and that is what
		keeps these castes out of factionless pawn generation.
	-->
	<PawnKindDef Name="PMM_InsectKindBase" Abstract="True">
		<maxGenerationAge>60</maxGenerationAge>
		<fixedGender>Female</fixedGender>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<!-- The neutral tribe by default. A pawn kind can name only one faction, and
		     the hostile tribe supplies its own faction through pawnGroupMakers, which
		     is how faction generation works anyway. -->
		<defaultFactionDef>PMM_InsectorHive</defaultFactionDef>
		<canArriveManhunter>false</canArriveManhunter>
		<apparelIgnorePollution>true</apparelIgnorePollution>
		<initialWillRange>0~4</initialWillRange>
		<initialResistanceRange>4~17</initialResistanceRange>
		<!-- The vanilla Insect faction defines no backstory categories, so every
		     concrete kind below carries its own backstoryFilters naming that species'
		     single spawn category (PMM_<Species>Spawn). Without that the generator logs
		     "no backstoryCategories in either" and picks random backstories.
		     Deliberately not on this abstract base: a category here would ride along
		     with the kind's own and put a second childhood in the pool. -->
		<moveSpeedFactorByTerrainTag>
			<li>
				<key>Insect</key>
				<value>2.0</value>
			</li>
		</moveSpeedFactorByTerrainTag>
	</PawnKindDef>

	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectDevilBug</defName>
		<label>devil bug</label>
		<race>PMM_Race_DevilBug</race>
		<combatPower>40</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_DevilBugSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectDevilBug>100</PMM_InsectDevilBug></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectGiantAnt</defName>
		<label>giant ant</label>
		<race>PMM_Race_GiantAnt</race>
		<combatPower>75</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_GiantAntSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectGiantAnt>100</PMM_InsectGiantAnt></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- Tribe trader (added 2026-09-22). A caravan trade and a visit at a hive village
	     both generate their trader through the faction's Trader pawn group, and vanilla
	     marks that slot's kind with trader:true + isFighter:false (Tribal_Trader /
	     Town_Trader), so the traders list gets its own kind instead of borrowing a
	     fighter. She is a giant ant - the caste that does the tribe's own work - and
	     keeps the same spawn backstory category and pinned xenotype as the others. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectTrader</defName>
		<label>tribe trader</label>
		<race>PMM_Race_GiantAnt</race>
		<trader>true</trader>
		<isFighter>false</isFighter>
		<combatPower>35</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_GiantAntSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectGiantAnt>100</PMM_InsectGiantAnt></xenotypeChances></xenotypeSet>
	</PawnKindDef>
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectSoldierBeetle</defName>
		<label>soldier beetle</label>
		<race>PMM_Race_SoldierBeetle</race>
		<combatPower>150</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_SoldierBeetleSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectSoldierBeetle>100</PMM_InsectSoldierBeetle></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectGreenworm</defName>
		<label>greenworm</label>
		<race>PMM_Race_Greenworm</race>
		<combatPower>25</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_GreenwormSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<abilities>
			<!-- Odyssey's acid spit, the one vanilla's own insect race carries
			     (Odyssey/Defs/ThingDefs_Races/Races_Animal_Insect.xml). Gated because
			     this mod requires Biotech and not Odyssey: ungated, the reference is
			     unresolved without Odyssey and the ability is quietly dropped from her
			     list. -->
			<li MayRequire="Ludeon.RimWorld.Odyssey">SludgeSpew</li>
		</abilities>
		<xenotypeSet><xenotypeChances><PMM_InsectGreenworm>100</PMM_InsectGreenworm></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectVampMosquito</defName>
		<label>vamp mosquito</label>
		<race>PMM_Race_VampMosquito</race>
		<combatPower>55</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_VampMosquitoSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectVampMosquito>100</PMM_InsectVampMosquito></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectAbaddon</defName>
		<label>abaddon</label>
		<race>PMM_Race_Abaddon</race>
		<combatPower>500</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_AbaddonSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<!-- She is the village queen, not a random combat pawn: the factions list her
		     in the Settlement group and nowhere else, so she garrisons a village and
		     never rolls into a raid. appearsRandomlyInCombatGroups stays at its default
		     true for exactly that reason - the old false kept her out of every group,
		     villages included. -->
		<canBeScattered>false</canBeScattered>
		<isBoss>true</isBoss>
		<!-- No <abilities> block: her egg spew is granted by the brood comp on her race def
		     instead, so it reaches her whether she was generated from this kind or transformed
		     into a queen later. One source, and the one that covers both paths (§5.11). -->
		<xenotypeSet><xenotypeChances><PMM_InsectAbaddon>100</PMM_InsectAbaddon></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- The weaver (2026-09-26). Tribe-only by design: `factionlessGenerationWeight 0` on her
	     xenotype, which is the only def that has that field, so she never appears among random
	     pawns or factionless events. Her spawn-table place landed 2026-09-27: she stands in the
	     hostile swarm's villages and nowhere else, and the abaddon can lay her. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectArachne</defName>
		<label>arachne</label>
		<race>PMM_Race_Arachne</race>
		<combatPower>110</combatPower>
		<!-- Masochist by species (user's call 2026-09-26). The kind is the right home and not a
		     gene: both spawn paths - a dev spawn and a daughter laid from an egg sac - generate
		     from this kind, so the trait lands either way. `PawnKindDef.forcedTraits` is a
		     `List<TraitRequirement>`, hence the nested `<def>`. What this does NOT cover is a
		     woman transformed into an arachne mid-game (her traits come from genes, not from a
		     kind); if that ever matters, the fix is a gene with `<forcedTraits>`. -->
		<forcedTraits>
			<li>
				<def>Masochist</def>
			</li>
		</forcedTraits>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_ArachneSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectArachne>100</PMM_InsectArachne></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- The fly (2026-09-27). Tribe-only, hostile tribe only: she is in no factionless pool and in no
	     spawn table but the swarm's own. Cheap in combat power on purpose - small, soft-shelled, and
	     the thing she brings to a fight is speed and a proboscis, not armour. No forced traits: the
	     user asked for genes only, and traits are not one of them. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectBeelzebub</defName>
		<label>beelzebub</label>
		<race>PMM_Race_Beelzebub</race>
		<combatPower>55</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_BeelzebubSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectBeelzebub>100</PMM_InsectBeelzebub></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- The assassin of the desert (2026-09-27). Tribe-only like her sisters: no factionless
	     pool, no spawn table but the swarm's own, no forced traits (her genes carry the
	     temperament - ecdysone overdrive and volatile both push her at people), and no raid
	     groups. Combat power a step above the arachne's 110: the charge and the venom are real. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectGirtablilu</defName>
		<label>girtablilu</label>
		<race>PMM_Race_Girtablilu</race>
		<combatPower>115</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_GirtabliluSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectGirtablilu>100</PMM_InsectGirtablilu></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- The ant mimic (2026-09-27). Tribe-only like her sisters: no factionless pool,
	     no spawn table but the hive's own, no forced traits, and no raid groups.
	     Combat power 70, close to the giant ant's 75 she is imitating: she is a
	     worker with a worker's frame, and what she brings is hands, not claws. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectAntArachne</defName>
		<label>ant arachne</label>
		<race>PMM_Race_AntArachne</race>
		<combatPower>70</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_AntArachneSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectAntArachne>100</PMM_InsectAntArachne></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- The farmer (2026-09-27). The hive's own caste, and the only one that makes honey: she
	     stands in the neutral hive's villages, in no raid group, and the swarm never fields her.
	     Combat power a worker's - she is unarmed, soft-bodied and has no business in a fight;
	     what she brings to a village is the harvest and the animals. No forced traits: the
	     user's list was genes, and traits are not one of them. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectHoneyBee</defName>
		<label>honey bee</label>
		<race>PMM_Race_HoneyBee</race>
		<combatPower>40</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_HoneyBeeSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectHoneyBee>100</PMM_InsectHoneyBee></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- The mothman (2026-10-01, CASTES-PLAN.md phase 2). A hive caste: her own backstory
	     category, a pinned xenotype, and no Combat weight anywhere (see the faction file). No
	     forced traits, because the user's list was genes and genes are where her Kind and Wimp
	     traits come from. combatPower 45 - the gentle one's number. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectMothman</defName>
		<label>mothman</label>
		<race>PMM_Race_Mothman</race>
		<combatPower>45</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_MothmanSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectMothman>100</PMM_InsectMothman></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- Her caravan kind (CASTES-PLAN.md §0 decisions 4 and 9): the mothman and the papillon lead
	     most hive caravans, so each has a <trader>true</trader> kind of her own, modelled on
	     PMM_InsectTrader. Neither caste is a fighter and neither walks as an escort - the Trader
	     group's guards stay soldier beetles. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectMothmanTrader</defName>
		<label>mothman trader</label>
		<race>PMM_Race_Mothman</race>
		<trader>true</trader>
		<isFighter>false</isFighter>
		<combatPower>35</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_MothmanSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectMothman>100</PMM_InsectMothman></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- The papillon (2026-10-01, CASTES-PLAN.md phase 2): the frailest caste in the mod, and
	     the cheapest to build - no new gene at all. combatPower 30. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectPapillon</defName>
		<label>papillon</label>
		<race>PMM_Race_Papillon</race>
		<combatPower>30</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_PapillonSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectPapillon>100</PMM_InsectPapillon></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectPapillonTrader</defName>
		<label>papillon trader</label>
		<race>PMM_Race_Papillon</race>
		<trader>true</trader>
		<isFighter>false</isFighter>
		<combatPower>35</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_PapillonSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectPapillon>100</PMM_InsectPapillon></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- The hornet (2026-10-01, CASTES-PLAN.md phase 3): the hive's fighter, and its only flier.
	     Combat power 110, between the giant ant's 75 and the soldier beetle's 150. No forced
	     traits: her temper is a gene (VRE_InsectVolatile) and her grudge is a gene. No caravan
	     kind either - she is not the sort of woman a hive sends to talk. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectHornet</defName>
		<label>hornet</label>
		<race>PMM_Race_Hornet</race>
		<combatPower>110</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_HornetSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectHornet>100</PMM_InsectHornet></xenotypeChances></xenotypeSet>
	</PawnKindDef>

	<!-- The mantis (2026-10-01, CASTES-PLAN.md phase 4): the swarm's glass cannon, and a swarm
	     caste only - she is in the swarm's raid groups, never in a hive village. Combat power
	     120, above the girtablilu's 115 and the hornet's 110: she kills faster than either, and
	     the price is that she dies faster too. No forced traits - her temper and her kill hunger
	     are both genes. No caravan kind: the swarm does not trade. -->
	<PawnKindDef ParentName="PMM_InsectKindBase">
		<defName>PMM_InsectMantis</defName>
		<label>mantis</label>
		<race>PMM_Race_Mantis</race>
		<combatPower>120</combatPower>
		<backstoryFilters>
			<li>
				<categories>
					<li>PMM_MantisSpawn</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet><xenotypeChances><PMM_InsectMantis>100</PMM_InsectMantis></xenotypeChances></xenotypeSet>
	</PawnKindDef>

</Defs>
